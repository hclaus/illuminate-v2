{
	"name": "illuminate-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:desktop": "cross-env DESKTOP_BUILD=1 VITE_API_URL=/api/v1 vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/d3": "^7.4.3",
		"@types/d3-contour": "^3.0.6",
		"@types/node": "^25.9.2",
		"@types/three": "^0.184.1",
		"@vitest/coverage-v8": "^4.1.8",
		"cross-env": "^10.1.0",
		"jsdom": "^29.1.1",
		"msw": "^2.14.6",
		"svelte": "^5.56.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@threlte/core": "^8.5.16",
		"@threlte/extras": "^9.21.0",
		"chart.js": "^4.5.1",
		"chartjs-plugin-zoom": "^2.2.0",
		"d3": "^7.9.0",
		"d3-contour": "^4.0.2",
		"three": "^0.184.0",
		"zod": "^4.4.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"msw"
		]
	}
}
